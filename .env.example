# Public browser configuration (safe project URL and anon/publishable key only)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Server configuration; never prefix privileged keys with NEXT_PUBLIC_
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-server-only-service-role-key

# Optional server-side Gemini access; choose a model available to your account
GEMINI_API_KEY=
GEMINI_MODEL=
